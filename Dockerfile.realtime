FROM node:22-bookworm-slim
ARG BUILD_SHA=development
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev
COPY backend ./backend
ENV NODE_ENV=production PORT=8080 DB_PATH=/data/bridge-crew.sqlite WO_DATA_DIR=/data BUILD_SHA=$BUILD_SHA
EXPOSE 8080
CMD ["node", "backend/server.mjs"]
